rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function householdDoc(h) {
      return get(/databases/$(database)/documents/households/$(h));
    }

    function isMember(h) {
      return signedIn() && uid() in householdDoc(h).data.members;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isShortString(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function optionalShortString(data, key, maxLen) {
      return !(key in data) || data[key] == null || isShortString(data[key], 0, maxLen);
    }

    function optionalTimestamp(data, key) {
      return !(key in data) || data[key] == null || data[key] is timestamp;
    }

    function unchanged(key) {
      return request.resource.data.get(key, null) == resource.data.get(key, null);
    }

    function present(data, key) {
      return key in data && data[key] != null;
    }

    function optionalNumberIn(data, key, minExclusive, maxInclusive) {
      return !(key in data) || data[key] == null
        || (data[key] is number && data[key] > minExclusive && data[key] <= maxInclusive);
    }

    function optionalIntIn(data, key, minInclusive, maxInclusive) {
      return !(key in data) || data[key] == null
        || (data[key] is int && data[key] >= minInclusive && data[key] <= maxInclusive);
    }

    // Only the caller's own entry in memberNames may change, and it must be a name.
    function ownMemberNameOnly() {
      let names = request.resource.data.memberNames;
      return names is map
        && names.diff(resource.data.memberNames).affectedKeys().hasOnly([uid()])
        && (!(uid() in names) || isShortString(names[uid()], 1, 50));
    }

    // ---------- households ----------

    match /households/{h} {
      allow get, list: if signedIn() && uid() in resource.data.members;

      // A new household contains only its creator.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'members', 'memberNames', 'createdAt'])
        && isShortString(request.resource.data.name, 1, 50)
        && request.resource.data.members == [uid()]
        && request.resource.data.memberNames.keys().hasOnly([uid()])
        && isShortString(request.resource.data.memberNames[uid()], 1, 50)
        && request.resource.data.createdAt == request.time;

      // Members may rename the household, their own display name and the active invite.
      allow update: if signedIn() && (memberUpdate() || joinUpdate(h));

      allow delete: if false;

      function memberUpdate() {
        return uid() in resource.data.members
          && changedKeys().hasOnly(['name', 'memberNames', 'inviteCode'])
          && isShortString(request.resource.data.name, 1, 50)
          && ownMemberNameOnly()
          && optionalShortString(request.resource.data, 'inviteCode', 6);
      }

      // A non-member adds only themselves, proving a valid invite via joinCode.
      function joinUpdate(h) {
        let invite = get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode));
        return !(uid() in resource.data.members)
          && changedKeys().hasOnly(['members', 'memberNames', 'joinCode'])
          && request.resource.data.members == resource.data.members.concat([uid()])
          && request.resource.data.members.size() <= 10
          && ownMemberNameOnly()
          && uid() in request.resource.data.memberNames
          && request.resource.data.joinCode is string
          && invite != null
          && invite.data.householdId == h
          && invite.data.expiresAt > request.time;
      }

      // ---------- health templates ----------
      // Built-in defaults live in the app; a doc overrides one by id or adds
      // a custom template. Written with merge, so createdAt is optional.
      match /healthTemplates/{t} {
        allow read: if isMember(h);
        allow create: if isMember(h)
          && validTemplate()
          && (!('createdAt' in request.resource.data)
            || request.resource.data.createdAt == request.time);
        allow update: if isMember(h) && validTemplate() && unchanged('createdAt');
        allow delete: if false;

        function validTemplate() {
          let t = request.resource.data;
          return t.keys().hasOnly(['name', 'type', 'intervalMonths', 'mandatory', 'active', 'createdAt'])
            && isShortString(t.name, 1, 50)
            && t.type in ['vaccination', 'deworming', 'ticks', 'vet']
            && optionalIntIn(t, 'intervalMonths', 1, 60)
            && t.mandatory is bool
            && t.active is bool;
        }
      }

      // ---------- dogs ----------

      match /dogs/{d} {
        allow read: if isMember(h);
        allow create: if isMember(h)
          && validDog()
          && request.resource.data.createdAt == request.time;
        allow update: if isMember(h)
          && validDog()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;

        function validDog() {
          let dog = request.resource.data;
          return dog.keys().hasOnly(['name', 'breed', 'birthDate', 'createdAt'])
            && isShortString(dog.name, 1, 50)
            && optionalShortString(dog, 'breed', 50)
            && optionalTimestamp(dog, 'birthDate');
        }

        // ---------- events ----------
        // `by` is the creator and never changes; partners may edit and
        // soft-delete each other's entries.
        match /events/{id} {
          allow read: if isMember(h);
          allow create: if isMember(h)
            && validEvent()
            && request.resource.data.by == uid()
            && request.resource.data.createdAt == request.time;
          allow update: if isMember(h)
            && validEvent()
            && unchanged('by')
            && unchanged('createdAt')
            && unchanged('type');
          // Soft delete only (`deleted: true`).
          allow delete: if false;
        }

        // ---------- weights ----------
        match /weights/{id} {
          allow read: if isMember(h);
          allow create: if isMember(h)
            && validWeight()
            && request.resource.data.by == uid()
            && request.resource.data.createdAt == request.time;
          allow update: if isMember(h)
            && validWeight()
            && unchanged('by')
            && unchanged('createdAt');
          allow delete: if false;
        }

        // ---------- foods ----------
        match /foods/{id} {
          allow read: if isMember(h);
          allow create: if isMember(h)
            && validFood()
            && request.resource.data.createdAt == request.time;
          allow update: if isMember(h) && validFood() && unchanged('createdAt');
          allow delete: if false;
        }

        // ---------- purchases ----------
        match /purchases/{id} {
          allow read: if isMember(h);
          allow create: if isMember(h)
            && validPurchase()
            && request.resource.data.by == uid()
            && request.resource.data.createdAt == request.time;
          allow update: if isMember(h)
            && validPurchase()
            && unchanged('by')
            && unchanged('createdAt');
          // Soft delete only (`deleted: true`).
          allow delete: if false;
        }

        // ---------- medications ----------
        match /meds/{id} {
          allow read: if isMember(h);
          allow create: if isMember(h)
            && validMed()
            && request.resource.data.createdAt == request.time;
          allow update: if isMember(h) && validMed() && unchanged('createdAt');
          allow delete: if false;
        }

        // One doc per med and scheduled slot (deterministic id), so both
        // partners ticking the same dose don't duplicate it. Whoever ticks
        // or unticks last becomes `by`.
        match /medDoses/{id} {
          allow read: if isMember(h);
          allow create, update: if isMember(h)
            && validDose()
            && request.resource.data.by == uid();
          allow delete: if false;
        }

        // ---------- health ----------
        match /health/{id} {
          allow read: if isMember(h);
          allow create: if isMember(h)
            && validHealth()
            && request.resource.data.by == uid()
            && request.resource.data.createdAt == request.time;
          allow update: if isMember(h)
            && validHealth()
            && unchanged('by')
            && unchanged('createdAt');
          // Soft delete only (`deleted: true`).
          allow delete: if false;
        }

        function validEvent() {
          let e = request.resource.data;
          return e.keys().hasOnly(['type', 'at', 'createdAt', 'by', 'foodId',
              'grams', 'poopScore', 'poopColor', 'durationMin', 'note', 'deleted'])
            && e.type in ['meal', 'poop', 'pee', 'walk', 'note']
            && e.at is timestamp
            // Not in the future, with slack for device clock skew.
            && e.at <= request.time + duration.value(1, 'h')
            && e.by is string
            && e.deleted is bool
            && optionalShortString(e, 'foodId', 100)
            && optionalNumberIn(e, 'grams', 0, 5000)
            && optionalIntIn(e, 'poopScore', 1, 7)
            && (!present(e, 'poopColor')
              || e.poopColor in ['brown', 'dark', 'yellow', 'green', 'grey', 'bloody'])
            && optionalIntIn(e, 'durationMin', 1, 1440)
            && optionalShortString(e, 'note', 500)
            && (e.type != 'meal' || present(e, 'grams'))
            && (e.type != 'poop' || present(e, 'poopScore'))
            && (e.type != 'walk' || present(e, 'durationMin'))
            && (e.type != 'note' || (present(e, 'note') && e.note.size() > 0));
        }

        function validWeight() {
          let w = request.resource.data;
          return w.keys().hasOnly(['kg', 'at', 'by', 'createdAt', 'deleted'])
            && w.kg is number && w.kg > 0 && w.kg < 150
            && w.at is timestamp
            && w.at <= request.time + duration.value(1, 'h')
            && w.by is string
            // Optional for entries written before stage 5.
            && (!('deleted' in w) || w.deleted is bool);
        }

        function validTime(t) {
          return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
        }

        function validMed() {
          let m = request.resource.data;
          return m.keys().hasOnly(['name', 'dose', 'scheduleType', 'times', 'intervalDays',
              'startDate', 'endDate', 'active', 'note', 'createdAt'])
            && isShortString(m.name, 1, 50)
            && optionalShortString(m, 'dose', 50)
            && m.scheduleType in ['daily', 'interval']
            && m.times is list && m.times.size() >= 1 && m.times.size() <= 3
            && validTime(m.times[0])
            && (m.times.size() < 2 || validTime(m.times[1]))
            && (m.times.size() < 3 || validTime(m.times[2]))
            && (m.scheduleType != 'interval'
              || (m.intervalDays is int && m.intervalDays >= 2 && m.intervalDays <= 60))
            && m.startDate is timestamp
            && (!present(m, 'endDate') || (m.endDate is timestamp && m.endDate >= m.startDate))
            && m.active is bool
            && optionalShortString(m, 'note', 500);
        }

        function validDose() {
          let d = request.resource.data;
          return d.keys().hasOnly(['medId', 'slot', 'givenAt', 'by', 'deleted'])
            && isShortString(d.medId, 1, 100)
            && d.slot is timestamp
            && d.givenAt is timestamp
            && d.givenAt <= request.time + duration.value(1, 'h')
            && d.deleted is bool;
        }

        function validHealth() {
          let e = request.resource.data;
          return e.keys().hasOnly(['type', 'templateId', 'name', 'date', 'nextDue',
              'note', 'by', 'createdAt', 'deleted'])
            && e.type in ['vaccination', 'deworming', 'ticks', 'vet']
            && optionalShortString(e, 'templateId', 100)
            && isShortString(e.name, 1, 50)
            && e.date is timestamp
            && e.date <= request.time + duration.value(1, 'h')
            && (!present(e, 'nextDue') || (e.nextDue is timestamp && e.nextDue >= e.date))
            && optionalShortString(e, 'note', 500)
            && e.by is string
            && e.deleted is bool;
        }

        function validFood() {
          let f = request.resource.data;
          return f.keys().hasOnly(['name', 'brand', 'rating', 'active', 'createdAt'])
            && isShortString(f.name, 1, 50)
            && optionalShortString(f, 'brand', 50)
            && (!present(f, 'rating') || f.rating in ['good', 'neutral', 'bad'])
            && f.active is bool;
        }

        function validPurchase() {
          let p = request.resource.data;
          return p.keys().hasOnly(['foodId', 'kg', 'price', 'at', 'by', 'createdAt', 'deleted'])
            && isShortString(p.foodId, 1, 100)
            && p.kg is number && p.kg > 0 && p.kg <= 100
            && (!present(p, 'price') || (p.price is number && p.price >= 0 && p.price <= 100000))
            && p.at is timestamp
            && p.at <= request.time + duration.value(1, 'h')
            && p.by is string
            && p.deleted is bool;
        }
      }
    }

    // ---------- invites ----------

    match /invites/{code} {
      // Fetch by code only; invites can't be enumerated.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.matches('^[A-HJ-KMNP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['householdId', 'createdBy', 'expiresAt', 'createdAt'])
        && isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        // 24 h validity plus slack for device clock skew.
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');

      allow update: if false;
      allow delete: if isMember(resource.data.householdId);
    }
  }
}
